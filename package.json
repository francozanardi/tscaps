{
  "name": "tscaps",
  "version": "0.0.0",
  "private": true,
  "description": "tscaps: edit talking-head videos for social media in the browser, with animated captions, by hand or through your AI agent.",
  "homepage": "https://tscaps.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francozanardi/tscaps.git"
  },
  "license": "SEE LICENSE IN README.md",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "pnpm --filter ./packages/engine build && pnpm --filter ./apps/studio build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "presets:build": "pnpm --filter ./apps/studio presets:build",
    "templates:contract": "pnpm --filter ./apps/studio templates:contract",
    "agent:setup": "pnpm --filter ./apps/studio mcp:setup",
    "postinstall": "pnpm presets:build"
  },
  "engines": {
    "node": ">=20"
  }
}
