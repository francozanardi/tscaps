{
  "name": "Juno",
  "category": "viral",
  "variants": [
    { "label": "Yellow", "overrides": { "highlight-color": "#ffdd00" } },
    { "label": "Cyan", "overrides": { "highlight-color": "#00e5ff" } },
    { "label": "Green", "overrides": { "highlight-color": "#3ddc84" } },
    { "label": "Pink", "overrides": { "highlight-color": "#ff4fa3" } },
    { "label": "Violet", "overrides": { "highlight-color": "#b388ff" } }
  ],
  "typography": {
    "fontStack": "bungee",
    "fontWeight": 400,
    "fontSize": 3.91,
    "wordSpacing": 0.12,
    "textCase": "uppercase",
    "italic": true
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "label": "Highlight",
      "type": "color",
      "default": "#ffdd00",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "shadow-color",
      "default": "#000000"
    },
    {
      "id": "stroke-width",
      "label": "Stroke",
      "type": "float",
      "default": 0.02,
      "min": 0,
      "max": 0.16,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "shadow-depth",
      "label": "Shadow depth",
      "type": "float",
      "default": 1.2,
      "min": 0.5,
      "max": 2,
      "step": 0.1,
      "group": "style",
      "subgroup": "appearance"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 25
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "maxLines": 2,
    "maxWidthRatio": 0.56
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.75
  }
}
