{
  "name": "Ren",
  "category": "viral",
  "description": "Hormozi-style word-by-word caption: heavy Montserrat uppercase with a thick black outline and hard shadow, each word springing in with a bounce the moment it is said; the word being spoken flashes green, punch words and names stay yellow with the punch words a size larger, and animated contextual emojis sit above by default. Maximum-retention look for business, coaching and podcast clips.",
  "addedOn": "2026-10-25",
  "variants": [
    {
      "label": "Green",
      "overrides": {
        "highlight-color": "#2cf26d"
      }
    },
    {
      "label": "Red",
      "overrides": {
        "highlight-color": "#ff3b30"
      }
    },
    {
      "label": "Cyan",
      "overrides": {
        "highlight-color": "#22d8ff"
      }
    },
    {
      "label": "Pink",
      "overrides": {
        "highlight-color": "#ff4fb8"
      }
    },
    {
      "label": "Orange",
      "overrides": {
        "highlight-color": "#ff9500"
      }
    }
  ],
  "typography": {
    "fontStack": "montserrat",
    "fontWeight": 900,
    "fontSize": 4.0,
    "letterSpacing": 0,
    "wordSpacing": 0.13,
    "lineSpacing": 0,
    "textCase": "uppercase"
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "label": "Highlight",
      "type": "color",
      "default": "#2cf26d",
      "group": "style",
      "subgroup": "colors",
      "legend": "The word being said, for as long as it is being said."
    },
    {
      "id": "tag-color",
      "label": "Accent",
      "type": "color",
      "default": "#ffe11a",
      "group": "style",
      "subgroup": "colors",
      "legend": "Punch words and names, which keep this colour for as long as the caption is on screen."
    },
    {
      "id": "outline-color",
      "label": "Outline color",
      "type": "color",
      "default": "#000000",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "shadow-color",
      "default": "#000000"
    },
    {
      "id": "outline-thickness",
      "label": "Outline thickness",
      "type": "float",
      "default": 0.13,
      "min": 0.04,
      "max": 0.2,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "filter-shadow-distance",
      "default": 0.09
    },
    {
      "id": "filter-shadow-blur",
      "default": 0.02
    },
    {
      "id": "word-pop",
      "label": "Bounce",
      "type": "float",
      "default": 0.14,
      "min": 0,
      "max": 0.4,
      "step": 0.01,
      "group": "motion",
      "subgroup": "words",
      "legend": "How far past its size a word springs as it appears."
    },
    {
      "id": "word-pop-duration",
      "label": "Bounce duration",
      "type": "float",
      "default": 0.28,
      "min": 0.1,
      "max": 0.6,
      "step": 0.01,
      "unit": "s",
      "group": "motion",
      "subgroup": "words"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 18,
      "minChars": 5
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "maxLines": 2,
    "maxWidthRatio": 0.70
  },
  "alignment": {
    "verticalAlign": "center",
    "verticalOffset": 0.69
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    },
    {
      "type": "remove_punctuation",
      "enabled": true
    },
    {
      "type": "emoji",
      "enabled": true,
      "placement": "segment-above",
      "size": 1.5,
      "gap": 1.2
    }
  ]
}
