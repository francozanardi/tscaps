{
  "name": "Kel",
  "category": "classic",
  "variants": [
    {
      "label": "Blue",
      "overrides": {
        "highlight-color": "#569cd6",
        "peak-bg-color": "#00008b"
      }
    },
    {
      "label": "Purple",
      "overrides": {
        "highlight-color": "#c586c0",
        "peak-bg-color": "#3a1f3a"
      }
    },
    {
      "label": "Teal",
      "overrides": {
        "highlight-color": "#4ec9b0",
        "peak-bg-color": "#103a34"
      }
    },
    {
      "label": "Orange",
      "overrides": {
        "highlight-color": "#ce9178",
        "peak-bg-color": "#3a2418"
      }
    },
    {
      "label": "Green",
      "overrides": {
        "highlight-color": "#b5cea8",
        "peak-bg-color": "#24331f"
      }
    }
  ],
  "typography": {
    "fontStack": "jetbrains-mono",
    "fontWeight": 400,
    "fontSize": 2.6,
    "wordSpacing": -0.02,
    "lineSpacing": 0.25
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#d4d4d4",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "upcoming-color",
      "label": "Upcoming word",
      "type": "color",
      "default": "#808080",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "label": "Active word",
      "type": "color",
      "default": "#569cd6",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "bg-color",
      "label": "Background",
      "type": "color",
      "default": "#1e1e1e",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-bg-color",
      "label": "Active word background",
      "type": "color",
      "default": "#252526",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "peak-bg-color",
      "label": "Peak background",
      "type": "color",
      "default": "#00008b",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "bg-radius",
      "label": "Line radius",
      "type": "float",
      "default": 0.18,
      "min": 0,
      "max": 1.5,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "word-padding-x",
      "label": "Word padding X",
      "type": "float",
      "default": 0.35,
      "min": 0,
      "max": 2.0,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "word-padding-y",
      "label": "Word padding Y",
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 1.0,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "sentence"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 48,
      "minChars": 12
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "minLines": 1,
    "maxLines": 2,
    "maxWidthRatio": 0.78
  },
  "alignment": {
    "verticalAlign": "bottom",
    "verticalOffset": 0.78,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    }
  ]
}
