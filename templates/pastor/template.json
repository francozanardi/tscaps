{
  "name": "Pastor",
  "category": "key-moments",
  "behindActor": {
    "required": true
  },
  "typography": {
    "fontStack": "manrope",
    "fontWeight": 500,
    "fontSize": 3.6,
    "letterSpacing": 0,
    "wordSpacing": 0.13,
    "lineSpacing": 0,
    "textCase": "none",
    "textAlign": "center"
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#e6d647",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "behind-font-family",
      "label": "Behind-actor font",
      "type": "font",
      "default": "anton",
      "group": "style",
      "subgroup": "appearance",
      "legend": "Face the caption takes while it sits behind the actor. The quiet captions keep the main font."
    },
    {
      "id": "behind-y",
      "label": "Behind-actor position",
      "type": "float",
      "default": 0.08,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "group": "style",
      "subgroup": "appearance",
      "legend": "Where the caption's top edge sits while it is behind the actor, down the frame. Independent of where the quiet captions are placed."
    },
    {
      "id": "behind-fill",
      "label": "Line width",
      "type": "float",
      "default": 0.98,
      "min": 0.7,
      "max": 1,
      "step": 0.01,
      "group": "style",
      "subgroup": "appearance",
      "legend": "How much of the video's width each line fills while the caption sits behind the actor."
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 13,
      "minChars": 5
    }
  ],
  "lineSplitter": {
    "type": "balanced",
    "minLines": 1,
    "maxLines": 1
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.75,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    },
    {
      "type": "remove_punctuation",
      "enabled": true
    }
  ]
}
