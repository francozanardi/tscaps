{
  "name": "Selene",
  "category": "modern",
  "variants": [
    {
      "label": "White",
      "overrides": {
        "primary-color": "#ffffff",
        "highlight-color": "#ffffff"
      }
    },
    {
      "label": "Sand",
      "overrides": {
        "primary-color": "#ffe6a8",
        "highlight-color": "#ffe6a8"
      }
    },
    {
      "label": "Ice",
      "overrides": {
        "primary-color": "#b8e6ff",
        "highlight-color": "#b8e6ff"
      }
    },
    {
      "label": "Sage",
      "overrides": {
        "primary-color": "#bdf5c4",
        "highlight-color": "#bdf5c4"
      }
    },
    {
      "label": "Rose",
      "overrides": {
        "primary-color": "#ffc4e0",
        "highlight-color": "#ffc4e0"
      }
    }
  ],
  "typography": {
    "fontStack": "montserrat",
    "fontWeight": 600,
    "fontSize": 3.6,
    "letterSpacing": 0,
    "wordSpacing": 0.1,
    "textCase": "none"
  },
  "rendering": {
    "videoFrame": {
      "required": true,
      "jpegQuality": 0.75,
      "previewMode": "live"
    }
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "label": "Active word",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "tag-font-family",
      "label": "Accent font",
      "type": "font",
      "default": "montserrat",
      "group": "style",
      "subgroup": "appearance",
      "legend": "Used for tagged words."
    },
    {
      "id": "tag-bold",
      "label": "Bold accents",
      "type": "toggle",
      "default": true,
      "valueOn": "900",
      "valueOff": "inherit",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "blur-amount",
      "label": "Glass blur",
      "type": "float",
      "default": 0.7,
      "min": 0,
      "max": 3,
      "step": 0.1,
      "unit": "cqh",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "tint-opacity",
      "label": "Tint strength",
      "type": "float",
      "default": 0.12,
      "min": 0,
      "max": 0.4,
      "step": 0.02,
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "highlight-opacity",
      "label": "Top highlight",
      "type": "float",
      "default": 0.4,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "corner-radius",
      "label": "Corner radius",
      "type": "float",
      "default": 2.0,
      "min": 0,
      "max": 2,
      "step": 0.05,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "border-opacity",
      "label": "Edge border",
      "type": "float",
      "default": 0.22,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "saturation",
      "label": "Color boost",
      "type": "float",
      "default": 1.5,
      "min": 0.5,
      "max": 2.5,
      "step": 0.1,
      "group": "style",
      "subgroup": "appearance"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 20,
      "minChars": 10
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "maxLines": 1
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.78
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    },
    {
      "type": "smart_punctuation",
      "enabled": true
    }
  ]
}
