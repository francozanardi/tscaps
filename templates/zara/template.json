{
  "name": "Zara",
  "category": "viral",
  "typography": {
    "fontStack": "anton",
    "fontWeight": 400,
    "fontSize": 4.69,
    "letterSpacing": 0.025,
    "wordSpacing": 0.1,
    "textCase": "uppercase"
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "label": "Highlight",
      "type": "color",
      "default": "#fff200",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "split-color-a",
      "label": "Glitch A",
      "type": "color",
      "default": "#ff00aa",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "split-color-b",
      "label": "Glitch B",
      "type": "color",
      "default": "#00e5ff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "split-x",
      "label": "Glitch offset",
      "type": "float",
      "default": 0.05,
      "min": 0,
      "max": 0.6,
      "step": 0.005,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "glow-radius",
      "default": 0.12
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 32
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "maxLines": 2
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.75
  }
}
