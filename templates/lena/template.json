{
  "name": "Lena",
  "category": "lab",
  "variants": [
    { "label": "Blue", "overrides": { "bg-color": "#2997ff" } },
    { "label": "Rose", "overrides": { "bg-color": "#e0457b" } },
    { "label": "Green", "overrides": { "bg-color": "#12924a" } },
    { "label": "Ember", "overrides": { "bg-color": "#c2410c" } },
    { "label": "Violet", "overrides": { "bg-color": "#7c4dff" } }
  ],
  "typography": {
    "fontStack": "inter",
    "fontWeight": 400,
    "fontSize": 2.5,
    "letterSpacing": 0,
    "wordSpacing": 0.13,
    "lineSpacing": 0.2,
    "textAlign": "start"
  },
  "styleControls": [
    {
      "id": "bg-color",
      "label": "Bubble",
      "type": "color",
      "default": "#2997ff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "tag-font-family",
      "label": "Accent font",
      "type": "font",
      "default": "inter",
      "group": "style",
      "subgroup": "appearance",
      "legend": "Used for tagged words."
    },
    {
      "id": "tag-font-weight",
      "label": "Accent weight",
      "type": "integer",
      "default": 900,
      "min": 100,
      "max": 900,
      "step": 100,
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "bg-radius",
      "label": "Bubble radius",
      "type": "float",
      "default": 0.6,
      "min": 0,
      "max": 1.5,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "bg-padding-x",
      "label": "Bubble padding X",
      "type": "float",
      "default": 0.47,
      "min": 0.1,
      "max": 1.5,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "bg-padding-y",
      "label": "Bubble padding Y",
      "type": "float",
      "default": 0.3,
      "min": 0.1,
      "max": 1.0,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "show-tail",
      "label": "Tail",
      "type": "toggle",
      "default": true,
      "valueOn": "block",
      "valueOff": "none",
      "group": "style",
      "subgroup": "appearance"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 60,
      "minChars": 30
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "minLines": 1,
    "maxLines": 3,
    "maxWidthRatio": 0.5
  },
  "alignment": {
    "verticalAlign": "bottom",
    "verticalOffset": 0.85,
    "horizontalAlign": "left",
    "horizontalOffset": 0.06
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    },
    {
      "type": "emoji",
      "placement": "word",
      "size": 1.4,
      "gap": 0.5,
      "enabled": true
    },
    {
      "type": "smart_punctuation",
      "enabled": true
    }
  ]
}
