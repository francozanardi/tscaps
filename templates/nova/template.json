{
  "name": "Nova",
  "category": "modern",
  "variants": [
    {
      "label": "Cyber Yellow",
      "overrides": {
        "primary-color": "#ffffff",
        "highlight-color": "#ffea00"
      }
    },
    {
      "label": "Electric Cyan",
      "overrides": {
        "primary-color": "#ffffff",
        "highlight-color": "#00e5ff"
      }
    },
    {
      "label": "Lime Green",
      "overrides": {
        "primary-color": "#ffffff",
        "highlight-color": "#3ddc84"
      }
    },
    {
      "label": "Hot Pink",
      "overrides": {
        "primary-color": "#ffffff",
        "highlight-color": "#ff4fa3"
      }
    },
    {
      "label": "Tangerine",
      "overrides": {
        "primary-color": "#ffffff",
        "highlight-color": "#ff9100"
      }
    },
    {
      "label": "Lavender",
      "overrides": {
        "primary-color": "#ffffff",
        "highlight-color": "#b388ff"
      }
    }
  ],
  "typography": {
    "fontStack": "poppins",
    "fontWeight": 700,
    "fontSize": 3.2,
    "letterSpacing": -0.02,
    "wordSpacing": 0.12,
    "lineSpacing": -0.25,
    "textAlign": "center",
    "textCase": "none"
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "label": "Highlight",
      "type": "color",
      "default": "#ffea00",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "rise-distance",
      "label": "Rise distance",
      "type": "float",
      "default": 0.75,
      "min": 0,
      "max": 2.5,
      "step": 0.05,
      "unit": "em",
      "group": "motion",
      "subgroup": "segments"
    },
    {
      "id": "rise-duration",
      "label": "Rise duration",
      "type": "float",
      "default": 0.25,
      "min": 0.05,
      "max": 1.5,
      "step": 0.05,
      "unit": "s",
      "group": "motion",
      "subgroup": "segments"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 30,
      "minChars": 6
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "minLines": 2,
    "maxLines": 2,
    "maxWidthRatio": 0.75
  },
  "alignment": {
    "verticalAlign": "bottom",
    "verticalOffset": 0.74,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    },
    {
      "type": "smart_punctuation",
      "enabled": true
    }
  ]
}
