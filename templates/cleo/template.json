{
  "name": "Cleo",
  "category": "modern",
  "variants": [
    {
      "label": "White",
      "overrides": {
        "primary-color": "#ffffff",
        "quote-color": "#e6d647"
      }
    },
    {
      "label": "Amber",
      "overrides": {
        "primary-color": "#ffd866",
        "quote-color": "#7be6ff"
      }
    },
    {
      "label": "Cyan",
      "overrides": {
        "primary-color": "#7be6ff",
        "quote-color": "#ffd866"
      }
    },
    {
      "label": "Green",
      "overrides": {
        "primary-color": "#86ff86",
        "quote-color": "#ff86c5"
      }
    },
    {
      "label": "Pink",
      "overrides": {
        "primary-color": "#ff86c5",
        "quote-color": "#86ff86"
      }
    }
  ],
  "typography": {
    "fontStack": "lora",
    "fontWeight": 500,
    "fontSize": 4.3,
    "letterSpacing": 0,
    "wordSpacing": 0.13,
    "textAlign": "center"
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "quote-color",
      "label": "Quote",
      "type": "color",
      "default": "#e6d647",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "outline-color",
      "label": "Outline",
      "type": "color",
      "default": "#000000",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "outline-thickness",
      "label": "Outline thickness",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 0.3,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "tag-weight",
      "label": "Emphasis weight",
      "type": "integer",
      "default": 900,
      "min": 100,
      "max": 900,
      "step": 100,
      "group": "style",
      "subgroup": "appearance",
      "legend": "Weight applied to emphasis-tagged words."
    },
    {
      "id": "tag-italic",
      "label": "Italic accents",
      "type": "toggle",
      "default": true,
      "valueOn": "italic",
      "valueOff": "normal",
      "group": "style",
      "subgroup": "appearance",
      "legend": "Italicizes accent and entity tagged words."
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 18,
      "minChars": 7
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "minLines": 1,
    "maxLines": 1,
    "maxWidthRatio": 0.73
  },
  "alignment": {
    "verticalAlign": "bottom",
    "verticalOffset": 0.65,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    },
    {
      "type": "carry_quotes",
      "enabled": true
    },
    {
      "type": "smart_punctuation",
      "enabled": true
    },
    {
      "type": "smart_lowercase",
      "enabled": true
    }
  ]
}
