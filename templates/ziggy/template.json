{
  "name": "Ziggy",
  "category": "lab",
  "description": "Neon-sign caption: rounded monoline Comfortaa glowing like bent glass tubing, every word waiting dim and unlit until it is said, then flickering on with a buzz of light and staying lit; the word being spoken burns white-hot and punch words glow in a second neon color. Glowing after-dark look for music, gaming, nightlife and aesthetic edits.",
  "addedOn": "2026-10-25",
  "variants": [
    {
      "label": "Pink",
      "overrides": {
        "primary-color": "#ff2fa8"
      }
    },
    {
      "label": "Blue",
      "overrides": {
        "primary-color": "#2f9bff"
      }
    },
    {
      "label": "Green",
      "overrides": {
        "primary-color": "#2bff88"
      }
    },
    {
      "label": "Purple",
      "overrides": {
        "primary-color": "#a64dff"
      }
    },
    {
      "label": "Orange",
      "overrides": {
        "primary-color": "#ff7b1c"
      }
    }
  ],
  "typography": {
    "fontStack": "comfortaa",
    "fontWeight": 700,
    "fontSize": 4.6,
    "letterSpacing": 0.01,
    "wordSpacing": 0.14,
    "lineSpacing": 0.05,
    "textCase": "none"
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Neon",
      "type": "color",
      "default": "#ff2fa8",
      "group": "style",
      "subgroup": "colors",
      "legend": "The colour of the tubing and of the light it throws."
    },
    {
      "id": "tag-color",
      "label": "Accent",
      "type": "color",
      "default": "#2de0ff",
      "group": "style",
      "subgroup": "colors",
      "legend": "The second tube, for punch words, lifts and names."
    },
    {
      "id": "shadow-color",
      "default": "#08000d"
    },
    {
      "id": "glow-radius",
      "default": 0.36
    },
    {
      "id": "ignite-duration",
      "label": "Flicker duration",
      "type": "float",
      "default": 0.6,
      "min": 0.15,
      "max": 1.2,
      "step": 0.01,
      "unit": "s",
      "group": "motion",
      "subgroup": "words",
      "legend": "How long a word stutters before it holds steady."
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 26,
      "minChars": 6
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "maxLines": 2,
    "maxWidthRatio": 0.75
  },
  "alignment": {
    "verticalAlign": "center",
    "verticalOffset": 0.7
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    },
    {
      "type": "remove_punctuation",
      "enabled": true
    }
  ]
}
