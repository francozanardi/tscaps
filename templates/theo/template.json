{
  "name": "Theo",
  "category": "classic",
  "variants": [
    { "label": "Gold", "overrides": { "highlight-color": "#ffd700" } },
    { "label": "Cyan", "overrides": { "highlight-color": "#00e5ff" } },
    { "label": "Green", "overrides": { "highlight-color": "#3ddc84" } },
    { "label": "Pink", "overrides": { "highlight-color": "#ff4fa3" } },
    { "label": "Violet", "overrides": { "highlight-color": "#b388ff" } }
  ],
  "typography": {
    "fontStack": "inter",
    "fontWeight": 900,
    "fontSize": 3.0,
    "wordSpacing": 0.15
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Past word",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "label": "Active word",
      "type": "color",
      "default": "#ffd700",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "upcoming-color",
      "label": "Upcoming word",
      "type": "color",
      "default": "#d8d8d8",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "bg-color",
      "label": "Background",
      "type": "color",
      "default": "#000000",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "upcoming-opacity",
      "label": "Upcoming opacity",
      "type": "float",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "group": "style",
      "subgroup": "appearance",
      "legend": "How transparent words become before they are narrated."
    },
    {
      "id": "bg-opacity",
      "label": "Background opacity",
      "type": "float",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "bg-radius",
      "label": "Background radius",
      "type": "float",
      "default": 0.2,
      "min": 0,
      "max": 1.5,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "bg-padding-x",
      "label": "Background padding X",
      "type": "float",
      "default": 0.55,
      "min": 0,
      "max": 3.0,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "bg-padding-y",
      "label": "Background padding Y",
      "type": "float",
      "default": 0.25,
      "min": 0,
      "max": 1.0,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "sentence"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 24,
      "minChars": 8
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "minLines": 1,
    "maxLines": 1,
    "maxWidthRatio": 0.79
  },
  "alignment": {
    "verticalAlign": "bottom",
    "verticalOffset": 0.78,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    }
  ],
  "unsupportedBrowsers": [
    "firefox"
  ]
}
