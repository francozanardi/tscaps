{
  "name": "Hugo",
  "category": "modern",
  "typography": {
    "fontStack": "gabarito",
    "fontWeight": 600,
    "fontSize": 3.5,
    "letterSpacing": -0.065,
    "wordSpacing": 0.13,
    "lineSpacing": 0,
    "textCase": "uppercase",
    "textAlign": "center"
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "tag-color",
      "label": "Accent",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors",
      "legend": "Colour of the lifted words, and of the bloom around them."
    },
    {
      "id": "shadow-color",
      "label": "Glow",
      "default": "#ffffff"
    },
    {
      "id": "shadow-blur",
      "label": "Glow size",
      "default": 0.267
    },
    {
      "id": "outline-color",
      "label": "Outline",
      "type": "color",
      "default": "#1a1a1a",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "outline-thickness",
      "label": "Outline thickness",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 0.3,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 22,
      "minChars": 9
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "minLines": 2,
    "maxLines": 2,
    "maxWidthRatio": 0.74
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.78,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    },
    {
      "type": "smart_punctuation",
      "enabled": true
    }
  ]
}
