{
  "name": "Yuki",
  "category": "classic",
  "variants": [
    { "label": "White", "overrides": { "primary-color": "#ffffff" } },
    { "label": "Amber", "overrides": { "primary-color": "#ffd866" } },
    { "label": "Cyan", "overrides": { "primary-color": "#7be6ff" } },
    { "label": "Green", "overrides": { "primary-color": "#86ff86" } },
    { "label": "Pink", "overrides": { "primary-color": "#ff86c5" } }
  ],
  "typography": {
    "fontStack": "inter",
    "fontWeight": 700,
    "fontSize": 2.7,
    "wordSpacing": 0.13
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "outline-color",
      "label": "Outline",
      "type": "color",
      "default": "#000000",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "outline-thickness",
      "label": "Outline thickness",
      "type": "float",
      "default": 0.1,
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 42,
      "minChars": 12
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "maxLines": 2
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.75
  }
}
