{
  "name": "Enzo",
  "category": "modern",
  "typography": {
    "fontStack": "inter",
    "fontWeight": 900,
    "fontSize": 5.2,
    "letterSpacing": -0.045,
    "wordSpacing": 0.12,
    "lineSpacing": 0,
    "textCase": "none",
    "textAlign": "center"
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "tag-color",
      "label": "Accent",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors",
      "legend": "Colour of the lifted words, and of the halo around them."
    },
    {
      "id": "shadow-color",
      "default": "#333333"
    },
    {
      "id": "outline-color",
      "label": "Outline",
      "type": "color",
      "default": "#000000",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "outline-thickness",
      "label": "Outline thickness",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 0.3,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "tag-font-family",
      "label": "Accent font",
      "type": "font",
      "default": "eb-garamond",
      "group": "style",
      "subgroup": "appearance",
      "legend": "Face the punch word and the proper nouns switch to."
    },
    {
      "id": "tag-font-weight",
      "label": "Accent weight",
      "type": "integer",
      "default": 400,
      "min": 100,
      "max": 900,
      "step": 100,
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "tag-font-scale",
      "label": "Accent size",
      "type": "float",
      "default": 1.4,
      "min": 1,
      "max": 1.6,
      "step": 0.05,
      "group": "style",
      "subgroup": "appearance",
      "legend": "How much larger the lifted words render; the ones that also change face take the full amount."
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 25,
      "minChars": 6
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "minLines": 1,
    "maxLines": 3,
    "maxWidthRatio": 0.65
  },
  "alignment": {
    "verticalAlign": "bottom",
    "verticalOffset": 0.72,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    },
    {
      "type": "smart_punctuation",
      "enabled": true
    }
  ]
}
