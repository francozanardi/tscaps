{
  "name": "Luna",
  "category": "key-moments",
  "typography": {
    "fontStack": "poppins",
    "fontWeight": 900,
    "fontSize": 5.0,
    "letterSpacing": 0,
    "wordSpacing": 0.14,
    "lineSpacing": 0.05,
    "textCase": "uppercase",
    "textAlign": "left"
  },
  "rendering": {
    "videoFrame": {
      "required": true,
      "jpegQuality": 0.7,
      "previewMode": "omit"
    }
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "word-rise",
      "label": "Rise",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1.5,
      "step": 0.01,
      "unit": "em",
      "group": "motion",
      "subgroup": "words"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 35,
      "minChars": 10
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "minLines": 1,
    "maxLines": 4,
    "maxWidthRatio": 0.52
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.20,
    "horizontalAlign": "left",
    "horizontalOffset": 0
  },
  "features": {
    "rotation": {
      "segment": false,
      "word": false
    },
    "animation": { "segment": false, "line": false }
  }
}
