{
  "name": "Elio",
  "category": "key-moments",
  "typography": {
    "fontStack": "bebas-neue",
    "fontWeight": 400,
    "fontSize": 6.0,
    "letterSpacing": 0.04,
    "wordSpacing": 0.13,
    "textCase": "uppercase"
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "label": "Highlight",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 80,
      "minChars": 4
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "minLines": 2,
    "maxLines": 6,
    "maxWidthRatio": 0.77
  },
  "alignment": {
    "verticalAlign": "center",
    "verticalOffset": 0.5,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    }
  ]
}
