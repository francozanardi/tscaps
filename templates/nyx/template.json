{
  "name": "Nyx",
  "category": "lab",
  "variants": [
    { "label": "Green", "overrides": { "primary-color": "#00ff41" } },
    { "label": "Amber", "overrides": { "primary-color": "#ffb000" } },
    { "label": "Cyan", "overrides": { "primary-color": "#33ccff" } },
    { "label": "Magenta", "overrides": { "primary-color": "#ff6ec7" } },
    { "label": "Violet", "overrides": { "primary-color": "#c08cff" } }
  ],
  "typography": {
    "fontStack": "vt323",
    "fontWeight": 400,
    "fontSize": 3.44,
    "letterSpacing": 0,
    "wordSpacing": 0.14,
    "textAlign": "start"
  },
  "rendering": {
    "splitWordsIntoLetters": true
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#00ff41",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "window-bg",
      "label": "Window background",
      "type": "color",
      "default": "#0d1117",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "titlebar-bg",
      "label": "Title bar",
      "type": "color",
      "default": "#1a1f29",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "titlebar-text",
      "label": "Title bar text",
      "type": "color",
      "default": "#7d8590",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "chrome-scale",
      "label": "Chrome size",
      "type": "float",
      "default": 1,
      "min": 0.5,
      "max": 2,
      "step": 0.05,
      "group": "style",
      "subgroup": "appearance",
      "legend": "Scales the title bar and traffic lights together."
    },
    {
      "id": "fixed-width",
      "label": "Fixed width",
      "type": "toggle",
      "default": false,
      "valueOn": "72.2cqw",
      "valueOff": "0cqw",
      "group": "style",
      "subgroup": "appearance",
      "legend": "Locks the window width so the chrome stays the same across scenes."
    },
    {
      "id": "title",
      "label": "Title",
      "type": "text",
      "default": "bash",
      "group": "style",
      "subgroup": "appearance"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 36
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "maxLines": 2
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.7
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    }
  ]
}
