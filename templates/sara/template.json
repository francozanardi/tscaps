{
  "name": "Sara",
  "category": "modern",
  "typography": {
    "fontStack": "im-fell-english",
    "fontWeight": 400,
    "fontSize": 4.92,
    "letterSpacing": -0.048,
    "wordSpacing": 0.11,
    "lineSpacing": 0,
    "textCase": "none",
    "textAlign": "center"
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "tag-color",
      "label": "Accent",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors",
      "legend": "Colour of the lifted words, and of the bloom around them."
    },
    {
      "id": "shadow-color",
      "default": "#000000"
    },
    {
      "id": "outline-color",
      "label": "Outline",
      "type": "color",
      "default": "#000000",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "outline-thickness",
      "label": "Outline thickness",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 0.3,
      "step": 0.01,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "tag-font-scale",
      "label": "Accent size",
      "type": "float",
      "default": 1.4,
      "min": 1,
      "max": 1.6,
      "step": 0.05,
      "group": "style",
      "subgroup": "appearance",
      "legend": "How much larger the lifted words render."
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 34,
      "minChars": 9
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "minLines": 1,
    "maxLines": 3,
    "maxWidthRatio": 0.6
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.62,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    },
    {
      "type": "smart_punctuation",
      "enabled": true
    }
  ]
}
