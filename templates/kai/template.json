{
  "name": "Kai",
  "category": "viral",
  "variants": [
    {
      "label": "Pink & teal",
      "overrides": {
        "split-color-a": "#ff2e63",
        "split-color-b": "#1fffd0"
      }
    },
    {
      "label": "Amber & blue",
      "overrides": {
        "split-color-a": "#ffb300",
        "split-color-b": "#2f6bff"
      }
    },
    {
      "label": "Violet & lime",
      "overrides": {
        "split-color-a": "#b14dff",
        "split-color-b": "#6dff4d"
      }
    },
    {
      "label": "Orange & cyan",
      "overrides": {
        "split-color-a": "#ff5c1f",
        "split-color-b": "#1fd4ff"
      }
    },
    {
      "label": "Magenta & mint",
      "overrides": {
        "split-color-a": "#ff2ec4",
        "split-color-b": "#2effb0"
      }
    }
  ],
  "typography": {
    "fontStack": "bricolage-grotesque",
    "fontWeight": 800,
    "fontSize": 5.0,
    "letterSpacing": 0.01,
    "wordSpacing": 0.14,
    "textCase": "uppercase"
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#e8e8ef",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "highlight-color",
      "label": "Active word",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "split-color-a",
      "label": "Split A",
      "type": "color",
      "default": "#ff2e63",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "split-color-b",
      "label": "Split B",
      "type": "color",
      "default": "#1fffd0",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "outline-color",
      "label": "Edge",
      "type": "color",
      "default": "#000000",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "split-x",
      "label": "Split sideways",
      "type": "float",
      "default": 0.09,
      "min": 0,
      "max": 0.6,
      "step": 0.005,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "split-y",
      "label": "Split up/down",
      "type": "float",
      "default": 0.085,
      "min": 0,
      "max": 0.6,
      "step": 0.005,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    },
    {
      "id": "outline-thickness",
      "label": "Edge size",
      "type": "float",
      "default": 0.025,
      "min": 0,
      "max": 0.1,
      "step": 0.005,
      "unit": "em",
      "group": "style",
      "subgroup": "appearance"
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "boundary_score_limit_by_chars",
      "maxChars": 14
    }
  ],
  "lineSplitter": {
    "type": "balanced-pixel-width",
    "maxLines": 1
  },
  "alignment": {
    "verticalAlign": "top",
    "verticalOffset": 0.68
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    }
  ]
}
