{
  "name": "@tscaps/engine",
  "version": "0.6.0",
  "description": "Burn subtitles into video in the browser. CSS-styled captions, frame-accurate export, no server.",
  "keywords": [
    "subtitles",
    "captions",
    "video",
    "browser",
    "whisper",
    "transcription",
    "webcodecs",
    "mediabunny",
    "ffmpeg-alternative"
  ],
  "private": false,
  "license": "MIT",
  "author": "Franco Zanardi",
  "homepage": "https://github.com/francozanardi/tscaps/tree/main/packages/engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francozanardi/tscaps.git",
    "directory": "packages/engine"
  },
  "bugs": {
    "url": "https://github.com/francozanardi/tscaps/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch & tsc-alias -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "bidi-js": "^1.0.3",
    "mediabunny": "^1.51.0"
  },
  "peerDependencies": {
    "onnxruntime-web": "^1.27.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "10.8.1",
    "globals": "17.5.0",
    "tsc-alias": "^1.8.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
