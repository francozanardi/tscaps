{
  "name": "Edie",
  "category": "magazine",
  "description": "Quiet one-line white Inter for most of the video, with the hook and the key lines set whole as an editorial poster: tight heavy Inter around one huge Fraunces italic word, each word appearing as it is said. Magazine-cover look for talking-head videos.",
  "addedOn": "2026-11-20",
  "typography": {
    "fontStack": "inter",
    "fontWeight": 700,
    "fontSize": 3.4,
    "letterSpacing": -0.01,
    "wordSpacing": 0.2,
    "lineSpacing": 0,
    "textAlign": "center"
  },
  "styleControls": [
    {
      "id": "primary-color",
      "label": "Text",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors"
    },
    {
      "id": "key-word-color",
      "label": "Key word",
      "type": "color",
      "default": "#ffffff",
      "group": "style",
      "subgroup": "colors",
      "legend": "The big word of a key line, and the stressed words between them."
    },
    {
      "id": "key-font-family",
      "label": "Key word font",
      "type": "font",
      "default": "fraunces",
      "group": "style",
      "subgroup": "appearance",
      "legend": "The second voice: the big word of a key line, in italic, and the stressed words between them."
    },
    {
      "id": "contrast-shadow",
      "label": "Contrast shadow",
      "type": "float",
      "default": 0.45,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "group": "style",
      "subgroup": "appearance",
      "legend": "A wide, soft dark shadow behind the text, for shots where it blends into the background."
    }
  ],
  "segmentSplitters": [
    {
      "type": "boundary",
      "mode": "clause"
    },
    {
      "type": "optimal_limit_by_chars",
      "minChars": 4,
      "maxChars": 14
    }
  ],
  "lineSplitter": {
    "type": "balanced",
    "minLines": 1,
    "maxLines": 1
  },
  "modes": {
    "base": {
      "label": "Captions"
    },
    "spotlight": {
      "label": "Posters",
      "legend": "The hook and the lines the video is built around.",
      "matchers": [
        {
          "type": "tag-condition",
          "condition": "hook or peak"
        }
      ],
      "segmentSplitters": [
        {
          "type": "boundary",
          "mode": "sentence"
        },
        {
          "type": "pause_based",
          "minGap": 0.6
        },
        {
          "type": "optimal_limit_by_chars",
          "maxChars": 48,
          "minChars": 14,
          "cutAfterTag": "emphasis"
        }
      ],
      "lineSplitter": {
        "type": "isolated-word",
        "minLetters": 3,
        "minSecondsOnScreen": 0.9,
        "tagPriority": [
          "emphasis",
          "accent"
        ],
        "allowFirstWord": true,
        "minSegmentWords": 4,
        "pickBy": "spoken-duration",
        "minLineChars": 3,
        "maxEdgeSpreadEm": 0.15
      }
    }
  },
  "alignment": {
    "verticalAlign": "center",
    "verticalOffset": 0.66,
    "horizontalAlign": "center",
    "horizontalOffset": 0.5
  },
  "effects": [
    {
      "type": "gap_free",
      "enabled": true
    },
    {
      "type": "remove_punctuation",
      "enabled": true
    }
  ]
}
