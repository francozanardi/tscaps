# Compiled from the Sass sources beside them by `pnpm presets:build`,
# which the root postinstall runs. Generated output is not committed here
# for the same reason it is not committed upstream: it would drift from
# the source it is built from.
presets/templates/*/style.build.css
presets/templates/*/filters.build.svg
presets/templates/*/controls.build.json
presets/templates/*/animations.build.json
presets/templates/_lib/animation/presets.build.json
presets/layer/animation/presets.build.json
presets/layer/stage/stage.build.json

